---
// src/pages/archivo.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Archivo | Aldán - Acaneo Collective">
    <Header />
    <main class="archivo-page">
        <header class="archivo-hero-banner">
            <img 
                src="/banners/archivo-banner.jpg" 
                alt="Archivo del mundo de Aldán" 
                class="hero-bg-img"
                draggable="false"
            />
            <div class="hero-gradient-overlay"></div>

            <div class="hero-text-overlay">
                <h1>ARCHIVO</h1>
                <p>Explora a fondo el universo de Aldán con la coleccion de notas y artículos creada por los historiadores aldaneros</p>
            </div>
        </header>

        <div class="archivo-container">
            <div id="archivoLoader" class="archivo-status">
                Cargando archivo...
            </div>

            <section id="archivoGrid" class="archivo-grid" aria-label="Lista de artículos"></section>
        </div>
    </main>
    <Footer />
</Layout>

<script>
    import { supabase } from '../lib/supabase';

    interface Articulo {
        id: string;
        slug: string;
        titulo: string;
        categoria: string | null;
        imagen_url: string;
        fecha_publicacion: string;
    }

    const grid = document.getElementById('archivoGrid');
    const loader = document.getElementById('archivoLoader');

    function renderArticulos(articulos: Articulo[]) {
        if (!grid || !loader) return;

        loader.style.display = 'none';
        grid.innerHTML = '';

        articulos.forEach((item) => {
            const card = document.createElement('a');
            card.href = `/archivo/leer?slug=${encodeURIComponent(item.slug)}`;
            card.className = 'archivo-card';

            card.innerHTML = `
                <div class="card-thumb">
                    <img src="${item.imagen_url}" alt="${item.titulo}" loading="lazy" />
                </div>
                <div class="card-body">
                    ${item.categoria ? `<span class="card-tag">${item.categoria}</span>` : ''}
                    <h2 class="card-title">${item.titulo}</h2>
                </div>
            `;

            grid.appendChild(card);
        });
    }

    async function cargarArchivo(intento = 1, yaLimpioJwt = false) {
        if (!grid || !loader) return;

        try {
            const { data, error } = await supabase
                .from('archivo_articulos')
                .select('id, slug, titulo, categoria, imagen_url, fecha_publicacion')
                .eq('publicado', true)
                .order('fecha_publicacion', { ascending: false });

            if (error) {
                const esJwtExpirado = error.message?.toLowerCase().includes('jwt expired');

                // Si el token local venció, limpiamos la sesión local y reintentamos sin token caducado
                if (esJwtExpirado && !yaLimpioJwt) {
                    console.warn('Token JWT expirado detectado. Limpiando sesión local y reintentando...');
                    await supabase.auth.signOut({ scope: 'local' });
                    return cargarArchivo(intento, true);
                }

                console.error(`Error cargando archivo (intento ${intento}):`, error);

                if (intento < 3) {
                    loader.textContent = 'Conectando con el archivo...';
                    window.setTimeout(() => cargarArchivo(intento + 1, yaLimpioJwt), 1500 * intento);
                    return;
                }

                loader.textContent = `No se pudieron cargar los artículos (${error.message}).`;
                return;
            }

            if (!data || data.length === 0) {
                loader.textContent = 'Aún no hay publicaciones en el archivo. ¡Vuelve pronto!';
                return;
            }

            renderArticulos(data as Articulo[]);
        } catch (err) {
            console.error(`Error inesperado cargando archivo (intento ${intento}):`, err);

            if (intento < 3) {
                loader.textContent = 'Conectando con el archivo...';
                window.setTimeout(() => cargarArchivo(intento + 1, yaLimpioJwt), 1500 * intento);
                return;
            }

            loader.textContent = 'No se pudieron cargar los artículos en este momento.';
        }
    }

    cargarArchivo();
</script>


<style>
    .archivo-page {
        width: 100%;
        min-height: 85dvh;
        background-color: #ffffff;
        color: #141418;
        padding: 0 0 5rem 0;
        box-sizing: border-box;
    }

    /* --- HERO BANNER A ANCHO COMPLETO CON DEGRADADO A BLANCO --- */
    .archivo-hero-banner {
        position: relative;
        width: 100%;
        height: clamp(380px, 56vh, 580px);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: hsl(0, 0%, 100%);
    }

    .hero-bg-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        z-index: 1;
    }

    .hero-gradient-overlay {
        position: absolute;
        inset: -2px;
        z-index: 2;
        background: linear-gradient(
            180deg,
            rgba(11, 11, 14, 0.35) 0%,
            rgba(11, 11, 14, 0.45) 48%,
            rgba(255, 255, 255, 0.75) 83%,
            #ffffff 100%
        );
    }

    .hero-text-overlay {
        position: relative;
        z-index: 3;
        max-width: 820px;
        padding: 0 1.5rem;
        text-align: center;
        color: #ffffff;
        transform: translateY(-6%);
    }

    .archivo-kicker {
        display: inline-block;
        font-family: var(--font-body, sans-serif);
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: #ffffff;
        background-color: #eb7443;
        padding: 0.25rem 0.9rem;
        border-radius: 999px;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .hero-text-overlay h1 {
        font-family: var(--font-accent, 'Fjalla One', sans-serif);
        font-size: clamp(2.8rem, 6vw, 4.5rem);
        line-height: 1.05;
        color: #ffffff;
        margin: 0 0 0.6rem 0;
        letter-spacing: 1.5px;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.65);
    }

    .hero-text-overlay p {
        font-family: var(--font-body, 'Epilogue', sans-serif);
        font-size: clamp(1rem, 1.4vw, 1.2rem);
        color: rgba(255, 255, 255, 0.94);
        max-width: 600px;
        margin: 0 auto;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
    }

    /* --- CONTENEDOR DE TARJETAS --- */
    .archivo-container {
        max-width: 1280px;
        margin: -2px auto 0 auto;
        padding: 2rem 1.5rem 0 1.5rem;
    }

    .archivo-status {
        text-align: center;
        padding: 3rem 1rem;
        font-size: 1.05rem;
        color: #000000;
    }

    /* Cuadrícula: 3 columnas en escritorio */
    .archivo-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    :global(.archivo-card) {
        display: flex;
        flex-direction: column;
        background-color: #ffffff;
        border: 1px solid #e6e6ec;
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease, border-color 0.25s ease;
    }

    :global(.archivo-card:hover) {
        transform: translateY(-6px);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.1);
        border-color: #29b7ef;
    }

    :global(.card-thumb) {
        width: 100%;
        aspect-ratio: 16 / 12;
        overflow: hidden;
        background-color: #f4f4f7;
    }

    :global(.card-thumb img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease;
    }

    :global(.archivo-card:hover .card-thumb img) {
        transform: scale(1.05);
    }

    :global(.card-body) {
        padding: 2rem 1.3rem 2rem 1.3rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        flex: 1;
    }

    :global(.card-tag) {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 1px;
        color: #29b7ef;
        text-transform: uppercase;
    }

    :global(.card-title) {
        font-family: var(--font-title, 'Fjalla One', sans-serif);
        font-size: 1.35rem;
        line-height: 1.25;
        color: #141418;
        margin: 0;
        transition: color 0.2s ease;
    }

    :global(.archivo-card:hover .card-title) {
        color: #29b7ef;
    }

    /* Móvil: exactamente 2 columnas */
    @media (max-width: 768px) {
        .archivo-page {
            padding: 0 0 3.5rem 0;
        }

        .archivo-hero-banner {
            height: clamp(320px, 46vh, 420px);
        }

        .archivo-container {
            padding: 0.5rem 1rem 0 1rem;
        }

        .archivo-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.9rem;
        }

        :global(.archivo-card) {
            border-radius: 12px;
        }

        :global(.card-body) {
            padding: 0.85rem 0.9rem 1.1rem 0.9rem;
        }

        :global(.card-title) {
            font-size: 1.05rem;
        }
    }
</style>