---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Map3d from '../components/Map3d.astro';
import Marquee from '../components/sections/Marquee.astro';
import Series from '../components/sections/Series.astro';
import Services from '../components/sections/Services.astro';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
---


<Layout title="Acaneo Collective | Animación, Arte y Diseño">
	<Header currentPage="inicio" />

    <main id="inicio">
        <HeroSlider />
        <Marquee />
        <Series />
        <Map3d />
        <Services />
        <NewsletterBanner />
        <Modals />
     </main>
      <Footer />
</Layout>


