---
// src/pages/mapa.astro
import Layout from '../layouts/Layout.astro';
import { REGIONES_ALDAN } from '../data/regiones';

---

<Layout title="Mapa de Aldán | Acaneo Collective">
    <main class="map-page">
        <div class="map-top-bar">
            <a href="/" class="back-btn">Volver</a>
            <div class="title-group">
                <h1>MAPA DEL MUNDO DE ALDÁN</h1>
                <p>Arrastra para explorar y toca cualquier región para descubrir su historia</p>
            </div>
            <div class="spacer"></div>
        </div>

        <!-- Visor del Mapa -->
        <div class="map-viewport" id="mapViewport">
            <!-- Botones flotantes de Zoom -->
            <div class="zoom-controls">
                <button type="button" id="zoomInBtn" aria-label="Acercar mapa" title="Acercar">+</button>
                <button type="button" id="zoomOutBtn" aria-label="Alejar mapa" title="Alejar">−</button>
                <button type="button" id="zoomResetBtn" aria-label="Restablecer vista" title="Restablecer">⟲</button>
            </div>

            <!-- Lienzo escalable del Mapa -->
            <div class="map-canvas" id="mapCanvas">
                <img 
                    src="/mapa/mapa-base.png" 
                    alt="Mapa completo del mundo de Aldán" 
                    class="base-map-img"
                    draggable="false"
                />

                {REGIONES_ALDAN.map((region) => (
                    <button
                        type="button"
                        class="map-pin"
                        style={`top: ${region.top}; left: ${region.left}; width: ${region.width};`}
                        data-nombre={region.nombre}
                        data-descripcion={region.descripcion }
                        data-imagen={region.imagenDetalle || region.pngSrc}
                        aria-label={`Ver información de ${region.nombre}`}
                    >
                        <img src={region.pngSrc} alt={region.nombre} draggable="false" />
                    </button>
                ))}

                <img 
                    src="/mapa/nubes.png" 
                    alt="" 
                    aria-hidden="true"
                    class="map-overlay-png"
                    draggable="false"
                />
            </div>
        </div>

        <!-- Ventana Modal horizontal (ilustración izquierda + contenido derecha) -->
        <dialog id="regionModal" class="region-modal">
            <div class="modal-card">
                <button type="button" id="closeModalBtn" class="close-btn" aria-label="Cerrar ventana">✕</button>

                <div class="modal-media">
                    <img id="modalImagen" src="" alt="" />
                </div>

                <div class="modal-content">
                    <span id="modalSubtitulo" class="modal-badge" hidden></span>
                    <h2 id="modalTitulo">Nombre de la Región</h2>
                    <div id="modalDescripcion"></div>
                </div>
            </div>
        </dialog>
    </main>
</Layout>

<script>
    const viewport = document.getElementById('mapViewport') as HTMLElement | null;
    const canvas = document.getElementById('mapCanvas') as HTMLElement | null;
    const zoomInBtn = document.getElementById('zoomInBtn');
    const zoomOutBtn = document.getElementById('zoomOutBtn');
    const zoomResetBtn = document.getElementById('zoomResetBtn');

    const modal = document.getElementById('regionModal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('closeModalBtn');
    const modalTitulo = document.getElementById('modalTitulo');
    const modalSubtitulo = document.getElementById('modalSubtitulo');
    const modalDescripcion = document.getElementById('modalDescripcion');
    const modalImagen = document.getElementById('modalImagen') as HTMLImageElement | null;


    // --- 1. CONTROL DE ZOOM CENTRADO ---
    let currentScale = 1;
    const MIN_SCALE = 1;
    const MAX_SCALE = 3.2;

    
    function applyZoom(newScale: number, focusX?: number, focusY?: number) {
        if (!canvas || !viewport) return;

        const targetScale = Math.min(Math.max(newScale, MIN_SCALE), MAX_SCALE);
        const isZoomed = targetScale > 1.01;

        // Punto focal dentro del viewport (por defecto, el centro exacto de la vista)
        const focalX = focusX ?? viewport.clientWidth / 2;
        const focalY = focusY ?? viewport.clientHeight / 2;

        // Proporción relativa de ese punto dentro del lienzo antes de escalar
        const prevWidth = canvas.offsetWidth || viewport.clientWidth;
        const prevHeight = canvas.offsetHeight || viewport.clientHeight;
        const relX = (viewport.scrollLeft + focalX) / prevWidth;
        const relY = (viewport.scrollTop + focalY) / prevHeight;

        // Activar o desactivar el modo scroll en el contenedor
        viewport.classList.toggle('is-zoomed', isZoomed);

        if (!isZoomed) {
            currentScale = 1;
            canvas.style.width = '100%';
            viewport.scrollLeft = 0;
            viewport.scrollTop = 0;
            return;
        }

        currentScale = targetScale;
        canvas.style.width = `${viewport.clientWidth * currentScale}px`;

        // Reposicionar el scroll para mantener el centro en el mismo punto del mapa
        const newWidth = canvas.offsetWidth;
        const newHeight = canvas.offsetHeight;
        viewport.scrollLeft = relX * newWidth - focalX;
        viewport.scrollTop = relY * newHeight - focalY;
    }

    zoomInBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        applyZoom(currentScale + 0.45);
    });

    zoomOutBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        applyZoom(currentScale - 0.45);
    });

    zoomResetBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        applyZoom(1);
    });

    window.addEventListener('resize', () => {
        if (!canvas || !viewport) return;
        canvas.style.width = currentScale <= 1.01 ? '100%' : `${viewport.clientWidth * currentScale}px`;
    });

    // --- 2. ARRASTRE (DRAG-TO-PAN) EN PC Y MÓVIL ---
    let isDragging = false;
    let hasMoved = false;
    let startX = 0;
    let startY = 0;
    let startScrollLeft = 0;
    let startScrollTop = 0;

    // Variables para pellizco de 2 dedos
    let initialPinchDistance = 0;
    let initialPinchScale = 1;
    let isPinching = false;

    function getTouchDistance(touches: TouchList): number {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.hypot(dx, dy);
    }

    // Ratón (PC)
    viewport?.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement).closest('.zoom-controls')) return;

        isDragging = true;
        hasMoved = false;
        viewport.classList.add('is-dragging');
        startX = e.clientX;
        startY = e.clientY;
        startScrollLeft = viewport.scrollLeft;
        startScrollTop = viewport.scrollTop;
    });

    window.addEventListener('mousemove', (e) => {
        if (!isDragging || !viewport) return;
        e.preventDefault();

        const dx = e.clientX - startX;
        const dy = e.clientY - startY;

        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
            hasMoved = true;
        }

        viewport.scrollLeft = startScrollLeft - dx;
        viewport.scrollTop = startScrollTop - dy;
    });

    window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        viewport?.classList.remove('is-dragging');
    });

    // Táctil (Móvil / Tablet: 1 dedo arrastra, 2 dedos hacen zoom)
    viewport?.addEventListener('touchstart', (e) => {
        if ((e.target as HTMLElement).closest('.zoom-controls')) return;

        if (e.touches.length === 2) {
            isPinching = true;
            isDragging = false;
            initialPinchDistance = getTouchDistance(e.touches);
            initialPinchScale = currentScale;
        } else if (e.touches.length === 1 && !isPinching) {
            isDragging = true;
            hasMoved = false;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            startScrollLeft = viewport.scrollLeft;
            startScrollTop = viewport.scrollTop;
        }
    }, { passive: true });

    viewport?.addEventListener('touchmove', (e) => {
        if (!viewport) return;

        if (e.touches.length === 2 && initialPinchDistance > 0) {
            e.preventDefault();
            const currentDistance = getTouchDistance(e.touches);
            const scaleFactor = currentDistance / initialPinchDistance;

            const rect = viewport.getBoundingClientRect();
            const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;
            const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;

            applyZoom(initialPinchScale * scaleFactor, midX, midY);
            return;
        }

        if (isDragging && e.touches.length === 1 && !isPinching) {
            e.preventDefault();
            const dx = e.touches[0].clientX - startX;
            const dy = e.touches[0].clientY - startY;

            if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
                hasMoved = true;
            }

            viewport.scrollLeft = startScrollLeft - dx;
            viewport.scrollTop = startScrollTop - dy;
        }
    }, { passive: false });

    viewport?.addEventListener('touchend', (e) => {
        if (e.touches.length < 2) {
            isPinching = false;
            initialPinchDistance = 0;
        }
        if (e.touches.length === 0) {
            isDragging = false;
        }
    });

    // --- 3. VENTANA MODAL DE REGIONES ---
    document.querySelectorAll('.map-pin').forEach((pin) => {
        pin.addEventListener('click', () => {
            if (hasMoved) {
                hasMoved = false;
                return;
            }

            const btn = pin as HTMLElement;
            if (!modal || !modalTitulo || !modalSubtitulo || !modalDescripcion || !modalImagen) return;

            modalTitulo.textContent = btn.dataset.nombre || '';
            modalSubtitulo.textContent = btn.dataset.subtitulo || '';
            function formatear(texto: string): string {
    return texto
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/~(.+?)~/g, '<span class="light">$1</span>');
}
            modalDescripcion.replaceChildren(
    ...(btn.dataset.descripcion || '')
        .split(/\n\s*\n/)
        .map((texto) => texto.trim())
        .filter(Boolean)
        .map((texto) => {
            const p = document.createElement('p');
             p.innerHTML = formatear(texto);
            return p;
        })
);
            modalImagen.src = btn.dataset.imagen || '';
            modalImagen.alt = btn.dataset.nombre || '';

            modal.showModal();
        });
    });

    closeBtn?.addEventListener('click', () => modal?.close());

    modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.close();
        }
    });
</script>

<style>
    :global(html),
    :global(body) {
        margin: 0;
        padding: 0;
        background-color: #eb7443;
    }

    .map-page {
        position: relative;
        width: 100%;
        min-height: 100dvh;
        padding: 4rem 2rem 3rem 2rem;
        box-sizing: border-box;
        background-color: #0b0b0e;
        background-image: url('/fondo-mapa.png');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        overflow-x: hidden;
    }

    .map-top-bar {
        width: 100%;
        max-width: 1550px;
        margin: 0 auto 1.2rem auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
    }

    .back-btn {
        justify-self: start;
        color: #ffffff;
        text-decoration: none;
        font-weight: bold;
        border: 1px solid #ffffff;
        padding: 0.5rem 1.1rem;
        border-radius: 10px;
        background: rgba(11, 11, 14, 0.35);
        backdrop-filter: blur(4px);
        transition: all 0.2s;
    }

    .back-btn:hover {
        background-color: #ffffff;
        color: #eb7443;
    }

    .title-group {
        justify-self: center;
        text-align: center;
    }

    .title-group h1 {
        font-family: var(--font-title);
        font-size: 3rem;
        color: #ffffff;
        margin: 0;
        letter-spacing: 1px;
        text-shadow: 0 3px 12px rgba(0, 0, 0, 0.45);
    }

    .title-group p {
        color: #ffffff;
        font-size: 1.2rem;
        margin: 0.25rem 0 0 0;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
    }

    /* Visor del Mapa */
    .map-viewport {
        position: relative;
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        border-radius: 20px;
        border: none;
        overflow: visible;
        touch-action: none;
        background: transparent;
        cursor: grab;
        scrollbar-width: thin;
        scrollbar-color: #29b7ef rgba(11, 11, 14, 0.3);
    }

    /* Activa el scroll interno al hacer zoom */
    .map-viewport.is-zoomed {
        overflow: auto !important;
        height: 78vh;
        max-height: 78vh;
    }

    .map-viewport.is-dragging {
        cursor: grabbing;
    }

    /* Nubes superpuestas */
    .map-overlay-png {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 108%;
        height: auto;
        max-width: none;
        pointer-events: none;
        user-select: none;
        z-index: 25;
        animation: mapPulseLoop 4.5s ease-in-out infinite;
        will-change: transform;
    }

    @keyframes mapPulseLoop {
        0%, 100% {
            transform: translate(-50%, -50%) scale(1);
        }
        50% {
            transform: translate(-50%, -50%) scale(1.025);
        }
    }

    /* Controles flotantes de Zoom */
    .zoom-controls {
        position: sticky;
        top: 12px;
        left: 12px;
        z-index: 30;
        display: inline-flex;
        gap: 0.4rem;
        padding: 0.35rem;
        margin: 12px 0 -54px 12px;
        background: #0b0b0e00;
        box-shadow: 0 4px 14px #00000000;
    }

    .zoom-controls button {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: #ffffff00;
        color: #ffffff;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, transform 0.1s;
    }

    .zoom-controls button:hover {
        background: #eb7443;
    }

    .zoom-controls button:active {
        transform: scale(0.94);
    }

    /* Lienzo interior donde viven el mapa base y los pines */
    .map-canvas {
        position: relative;
        width: 100%;
        user-select: none;
        -webkit-user-select: none;
    }

    .base-map-img {
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    /* Carteles e iconos PNG interactivos */
    .map-pin {
        position: absolute;
        transform: translate(-50%, -50%);
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        z-index: 10;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
    }

    .map-pin img {
        width: 100%;
        height: auto;
        display: block;
        pointer-events: none;
    }

    .map-pin:hover,
    .map-pin:focus-visible {
        transform: translate(-50%, -50%) scale(1.18);
        z-index: 20;
        outline: none;
    }

    /* Ventana Modal horizontal centrada en pantalla */
    .region-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        border: none;
        border-radius: 20px;
        background: transparent;
        padding: 0;
        max-width: 920px;
        width: min(92vw, 920px);
        color: #ffffff;
        box-shadow: 0 28px 65px rgba(0, 0, 0, 0.78);
        z-index: 9999;
        overflow: visible;
    }

    .region-modal::backdrop {
        background: rgba(11, 11, 14, 0.72);
        backdrop-filter: blur(5px);
    }

    .modal-card {
        position: relative;
        display: grid;
        grid-template-columns: 44% 56%;
        min-height: 430px;
        max-height: 85dvh;
        background: #0c1015;
        border: #eb7443 solid 3px;
        border-radius: 20px;
        
        overflow: hidden;
        animation: popIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes popIn {
        from { opacity: 0; transform: scale(0.94); }
        to { opacity: 1; transform: scale(1); }
    }

    /* Mitad izquierda: ilustración a sangre completa */
    .modal-media {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 430px;
        background: #181c22;
        overflow: hidden;
    }

    .modal-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    /* Mitad derecha: título y descripción */
    .modal-content :global(p) {
    color: #e6e9ee;
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    line-height: 1.65;
    margin: 0;
}

.modal-content :global(p + p) {
    margin-top: 1rem;
}
.modal-content :global(.light) {
    font-weight: 200;
    color: hwb(214 91% 7% / 0.829);
}
    .modal-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2.5rem 3rem 2.5rem 2.5rem;
        text-align: left;
        overflow-y: auto;
    }

    .modal-content h2 {
        font-family: var(--font-title);
        font-size: clamp(2rem, 3.6vw, 2.8rem);
        line-height: 1.1;
        color: #eb7443;
        margin: 0 0 1.15rem 0;
        letter-spacing: 0.5px;
    }

    .modal-content p {
        color: #e6e9ee;
        font-size: clamp(0.98rem, 1.15vw, 1.08rem);
        line-height: 1.65;
        margin: 0;
    }

    /* Botón cerrar discretamente arriba a la derecha */
    .close-btn {
        position: absolute;
        top: 1.1rem;
        right: 1.25rem;
        z-index: 5;
        background: transparent;
        border: none;
        color: #8c93a0;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        font-size: 1.15rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    .close-btn:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
    }

    /* Adaptación a Móviles */
    @media (max-width: 768px) {
        .map-page {
            padding: 1rem 1rem 2rem 1rem;
        }

        .map-top-bar {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .back-btn {
            justify-self: center;
        }

        .spacer {
            display: none;
        }

        .title-group h1 {
            font-size: 1.6rem;
        }

        .map-viewport {
            max-height: none;
            border-radius: 12px;
        }

        .map-viewport.is-zoomed {
            height: 68vh;
            max-height: 68vh;
        }

        .region-modal {
            width: 94vw;
        }

        .modal-card {
            grid-template-columns: 1fr;
            grid-template-rows: 220px auto;
            min-height: auto;
            max-height: 100dvh;
        }

        .modal-media {
            min-height: 220px;
            height: 300px;
        }

        .modal-content {
            padding: 6.5rem 1.4rem 1.8rem 1.4rem;
        }

        .close-btn {
            top: 0.75rem;
            right: 0.75rem;
            background: rgba(12, 16, 21, 0.65);
            color: #ffffff;
        }
    }
</style>