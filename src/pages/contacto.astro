---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto | Acaneo Collective">
    <Header currentPage="contacto" />
    <main class="contacto-main" >
        <div class="contacto-container">
            
            <!-- Columna Izquierda: Título, texto e ilustración -->
            <div class="contacto-info">
                <h1 class="contacto-title">Comunícate con nosotros</h1>
                <p class="contacto-desc">
                    Ya sea que tengas una pregunta, una idea o solo quieras saludar, contáctanos: estamos aquí para ayudarte.
                </p>
                <div class="contacto-img-container">
                    <img src="/contacto-personajes.png" alt="Personajes Acaneo" class="contacto-img" />
                </div>
            </div>

            <!-- Columna Derecha: Formulario de contacto -->
            <!-- NOTA: Reemplaza "YOUR_ACCESS_KEY_HERE" con tu clave gratuita de Web3Forms (es gratis y llega a tu correo) -->
            <form action="https://api.web3forms.com/submit" method="POST" class="contacto-form">
                
                <!-- Tu clave de Web3Forms para que llegue a acaneocollective@gmail.com -->
                <input type="hidden" name="access_key" value="9c366f90-d601-4818-99d7-c0f72a33f590" />
                
                <!-- Redirección opcional tras enviar (puedes crear una página de gracias o dejar la misma) -->
                <input type="hidden" name="subject" value="Nuevo mensaje desde la web de Acaneo" />

                <div class="form-row">
                    <div class="form-group">
                        <label for="nombre">Nombre (obligatorio)</label>
                        <input type="text" id="nombre" name="nombre" required class="form-input" />
                    </div>
                    <div class="form-group">
                        <label for="apellido">Apellido (obligatorio)</label>
                        <input type="text" id="apellido" name="apellido" required class="form-input" />
                    </div>
                </div>

                <div class="form-group full-width">
                    <label for="email">Correo electrónico (obligatorio)</label>
                    <input type="email" id="email" name="email" required class="form-input" />
                </div>

                <div class="form-group full-width">
                    <label class="form-label-title">¿Qué servicios te interesan?</label>
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" name="servicio" value="Producción de animación" checked />
                            <span class="radio-custom"></span>
                            Producción de animación
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="servicio" value="Desarrollo de arte y diseño" />
                            <span class="radio-custom"></span>
                            Desarrollo de arte y diseño
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="servicio" value="Otro servicio" />
                            <span class="radio-custom"></span>
                            Otro servicio
                        </label>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label for="detalles">Detalles del proyecto (obligatorio)</label>
                    <textarea id="detalles" name="detalles" rows="5" required class="form-textarea"></textarea>
                </div>

                <button type="submit" class="btn-enviar">Enviar</button>
            </form>

        </div>
    </main>

    <Footer />
</Layout>

<style>
    .contacto-main {
        background-color: #29b7ef; /* Fondo azul corporativo exacto de tu diseño */
        min-height: calc(100vh - 80px);
        padding: 8rem 2rem 5rem 2rem;
        display: flex;
        align-items: center;
        color: #ffffff;
    }

    .contacto-container {
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: start;
        width: 100%;
    }

    /* Columna Izquierda */
    .contacto-title {
        font-family: var(--font-title);
        font-size: clamp(2.5rem, 4vw, 3.8rem);
        letter-spacing: 1.5px;
        margin-bottom: 1.2rem;
        line-height: 1.1;
    }

    .contacto-desc {
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 3rem;
        max-width: 480px;
    }

    .contacto-img-container {
        max-width: 420px;
    }

    .contacto-img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
    }

    /* Columna Derecha (Formulario) */
    .contacto-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-group label {
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: #ffffff;
    }

    .form-label-title {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .form-input {
        background-color: #d8f1fc; /* Tono celeste claro estilo píldora de tu imagen */
        border: none;
        border-radius: 8px;
        padding: 0.85rem 1rem;
        font-family: var(--font-body);
        font-size: 1rem;
        color: #000000;
        outline: none;
        transition: box-shadow 0.2s ease;
    }

    .form-input:focus, .form-textarea:focus {
        box-shadow: 0 0 0 2px #ffffff;
    }

    .form-textarea {
        background-color: #d8f1fc;
        border: none;
        border-radius: 12px;
        padding: 1rem;
        font-family: var(--font-body);
        font-size: 1rem;
        color: #000000;
        resize: vertical;
        outline: none;
    }

    /* Radio buttons personalizados */
    .radio-group {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-top: 0.3rem;
    }

    .radio-label {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 400;
    }

    .radio-label input[type="radio"] {
        accent-color: #ffffff;
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    /* Botón Enviar */
    .btn-enviar {
        background: transparent;
        color: #ffffff;
        border: 2px solid #ffffff;
        padding: 0.75rem 2.5rem;
        border-radius: 12px;
        font-family: var(--font-title);
        font-size: 1.2rem;
        letter-spacing: 1px;
        cursor: pointer;
        align-self: flex-start;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
        margin-top: 1rem;
    }

    .btn-enviar:hover {
        background-color: #ffffff;
        color: #29b7ef;
        transform: translateY(-2px);
    }

    /* Responsive Móvil */
    @media(max-width: 900px) {
        .contacto-container {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        .form-row {
            grid-template-columns: 1fr;
        }
        .contacto-main {
            padding: 7rem 1.5rem 3rem 1.5rem;
        }
    }
</style>