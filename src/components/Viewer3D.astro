---
// src/components/Viewer3D.astro
export interface Props {
    src: string;
    alt?: string;
    poster?: string;
    autoRotate?: boolean;
}

const { 
    src, 
    alt = "Modelo 3D Acaneo Collective", 
    poster = "", 
    autoRotate = true 
} = Astro.props;
---

<div class="viewer-wrapper">
    <model-viewer
        src={src}
        alt={alt}
        poster={poster}
        camera-controls
        touch-action="pan-y"
        auto-rotate={autoRotate}
        shadow-intensity="1"
        exposure="1.1"
        interaction-prompt="auto"
        class="acaneo-3d-canvas"
    >
        <!-- Barra de carga personalizada -->
        <div slot="progress-bar" class="loading-bar">
            <div class="update-bar"></div>
        </div>
    </model-viewer>
    <span class="controls-hint">🖱️ Arrastra para rotar · Rueda para zoom</span>
</div>

<!-- Cargamos el script oficial de model-viewer de forma asíncrona -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>

<style>
    .viewer-wrapper {
        position: relative;
        width: 140%;
        max-width: 850px; /* Antes estaba en 500px; subirlo permite que crezca más a lo ancho */
        margin: 0;
        background: transparent;
        border: 2px solid hsla(197, 86%, 55%, 0);
        border-radius: 0px;
        overflow: visible;
    }

    .acaneo-3d-canvas {
    width: 100%;
    height: 650px; /* Altura generosa en escritorio (puedes subirlo a 700px o 75vh si lo quieres aún mayor) */
    display: block;
    background-color: transparent;
    --poster-color: transparent;
    outline: none;
}

    /* Mantiene una altura cómoda en pantallas de móvil */
    @media (max-width: 850px) {
        .acaneo-3d-canvas {
            height: 400px;
        }
    }

    .controls-hint {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(11, 11, 14, 0.8);
        border: 1px solid #2a2a32;
        color: #a0a0a5;
        font-size: 0.8rem;
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        pointer-events: none;
        white-space: nowrap;
    }

  /* Barra de progreso discreta mientras carga */
   /.loading-bar {
        display: block;
        width: 40%;
        height: 3px;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 4px;
        background-color: rgba(255, 255, 255, 0.1);
        overflow: hidden;
    }

   /.update-bar {
        background-color: #eb7443;
        width: 100%;
        height: 100%;
        animation: pulse 0.5s infinite ease-in-out;
    }

    @keyframes pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 1; }
    }
</style>