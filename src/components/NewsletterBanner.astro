---
// src/components/NewsletterBanner.astro
---

<section class="newsletter-banner" aria-labelledby="newsletterHeading">
    <div class="newsletter-container">
        <!-- Columna izquierda: Textos y botón -->
        <div class="newsletter-content">
            <h2 id="newsletterHeading">NO TE PIERDAS NADA</h2>
            <p>¡Entérate de las últimas noticias de Aldán y todo lo relacionado al colectivo!</p>
            <button type="button" id="openNewsletterBtn" class="newsletter-cta">
                ¡Únete al boletín!
            </button>
        </div>

        <!-- Columna derecha: Ilustración de los sobres -->
        <div class="newsletter-art">
            <img 
                src="/banners/sobre-newsletter.png" 
                alt="Cartas selladas de Acaneo Collective" 
                loading="lazy"
                draggable="false"
            />
        </div>
    </div>

    <!-- Pop-up Modal de Suscripción -->
    <dialog id="newsletterModal" class="nl-modal">
        <div class="nl-card">
            <button type="button" id="closeNewsletterBtn" class="nl-close" aria-label="Cerrar ventana">✕</button>
            <h3>¡BIENVENIDO A ALDÁN!</h3>
            <p class="nl-subtitle">Recibe adelantos exclusivos, fechas de estreno y sorpresas directamente en tu buzón.</p>

            <form id="newsletterForm" class="nl-form">
                <input 
                    type="text" 
                    id="nlName" 
                    placeholder="Tu nombre o apodo (opcional)" 
                    autocomplete="name"
                />
                <input 
                    type="email" 
                    id="nlEmail" 
                    placeholder="tu@correo.com" 
                    required 
                    autocomplete="email"
                />
                <button type="submit" id="nlSubmitBtn" class="nl-submit">
                    Suscribirme ahora
                </button>
            </form>

            <p id="nlFeedback" class="nl-feedback" role="status"></p>
        </div>
    </dialog>
</section>

<script>
    import { supabase } from '../lib/supabase';

    const openBtn = document.getElementById('openNewsletterBtn');
    const closeBtn = document.getElementById('closeNewsletterBtn');
    const modal = document.getElementById('newsletterModal') as HTMLDialogElement | null;
    const form = document.getElementById('newsletterForm') as HTMLFormElement | null;
    const nameInput = document.getElementById('nlName') as HTMLInputElement | null;
    const emailInput = document.getElementById('nlEmail') as HTMLInputElement | null;
    const submitBtn = document.getElementById('nlSubmitBtn') as HTMLButtonElement | null;
    const feedback = document.getElementById('nlFeedback');

    openBtn?.addEventListener('click', () => {
        if (feedback) {
            feedback.textContent = '';
            feedback.className = 'nl-feedback';
        }
        modal?.showModal();
        emailInput?.focus();
    });

    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!emailInput || !submitBtn || !feedback) return;

        const email = emailInput.value.trim().toLowerCase();
        const nombre = nameInput?.value.trim() || null;

        if (!email) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Registrando...';
        feedback.textContent = '';

        const { error } = await supabase
            .from('newsletter_suscriptores')
            .insert([{ email, nombre, origen: window.location.pathname }]);

        submitBtn.disabled = false;
        submitBtn.textContent = 'Suscribirme ahora';

        if (!error) {
            feedback.textContent = '¡Listo! Ya formas parte del boletín de Acaneo Collective.';
            feedback.className = 'nl-feedback success';
            form.reset();
        } else if (error.code === '23505') {
            // Código 23505 = correo ya registrado (UNIQUE constraint)
            feedback.textContent = '¡Este correo ya estaba suscrito al boletín!';
            feedback.className = 'nl-feedback success';
        } else {
            feedback.textContent = 'Ocurrió un problema al guardar tu correo. Inténtalo de nuevo.';
            feedback.className = 'nl-feedback error';
        }
    });
</script>

<style>
    .newsletter-banner {
        position: relative;
        width: 100%;
        background-color: #eb7443; /* Mismo naranja exacto de la sección anterior */
        color: #ffffff;
        overflow: hidden;
        margin: -2px 0 0 0; /* Elimina la línea blanca de subpíxel entre secciones */
        padding: 0;
        border: none;
    }

    .newsletter-container {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 2rem;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: stretch;
        gap: 2rem;
    }

    .newsletter-content {
        padding: 3rem 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
    }

    .newsletter-content h2 {
        font-family: var(--font-title, 'Fjalla One', sans-serif);
        font-size: clamp(2.3rem, 4.2vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: 1px;
        color: #ffffff;
        margin: 0 0 0.75rem 0;
        text-transform: uppercase;
    }

    .newsletter-content p {
        font-family: var(--font-body, 'Epilogue', sans-serif);
        font-size: clamp(1rem, 1.3vw, 1.2rem);
        line-height: 1.45;
        color: #fff6f2;
        max-width: 440px;
        margin: 0 0 1.5rem 0;
    }

    .newsletter-cta {
        background-color: #fff5f0;
        color: #eb7443;
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2rem;
        font-family: var(--font-title, 'Fjalla One', sans-serif);
        font-size: 1.35rem;
        letter-spacing: 0.5px;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s;
    }

    .newsletter-cta:hover {
        background-color: #ffffff;
        transform: translateY(-3px) scale(1.03);
    }

    /* Ancla las cartas directamente al borde inferior sin dejar franja naranja debajo */
    .newsletter-art {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        align-self: end;
        line-height: 0;
    }

    .newsletter-art img {
        width: 100%;
        max-width: 880px;
        height: auto;
        display: block;
        object-fit: contain;
        margin-bottom: -1px;
    }

    /* --- MODAL DE SUSCRIPCIÓN --- */
    .nl-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        border: none;
        background: transparent;
        padding: 0;
        width: 92%;
        max-width: 440px;
        z-index: 9999;
    }

    .nl-modal::backdrop {
        background: rgba(11, 11, 14, 0.82);
        backdrop-filter: blur(6px);
    }

    .nl-card {
        position: relative;
        background: #141418;
        border: 3px solid #eb7443;
        border-radius: 24px;
        padding: 2.2rem 1.8rem;
        text-align: center;
        color: #ffffff;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.85);
    }

    .nl-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #0b0b0e;
        border: 1px solid #333;
        color: #a0a0a5;
        cursor: pointer;
    }

    .nl-close:hover {
        background: #eb7443;
        color: #ffffff;
    }

    .nl-badge {
        display: inline-block;
        background: rgba(235, 116, 67, 0.18);
        color: #eb7443;
        border: 1px solid #eb7443;
        font-size: 0.75rem;
        font-weight: 800;
        padding: 0.25rem 0.8rem;
        border-radius: 999px;
        margin-bottom: 0.6rem;
    }

    .nl-card h3 {
        font-family: var(--font-title, sans-serif);
        font-size: 1.8rem;
        margin: 0 0 0.5rem 0;
    }

    .nl-subtitle {
        color: #c8c8d0;
        font-size: 0.95rem;
        margin: 0 0 1.4rem 0;
    }

    .nl-form {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .nl-form input {
        width: 100%;
        padding: 0.85rem 1rem;
        border-radius: 12px;
        border: 1px solid #333;
        background: #0b0b0e;
        color: #ffffff;
        font-family: var(--font-body, sans-serif);
        font-size: 0.95rem;
    }

    .nl-form input:focus {
        outline: none;
        border-color: #eb7443;
    }

    .nl-submit {
        margin-top: 0.3rem;
        background: #eb7443;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 0.9rem;
        font-family: var(--font-title, sans-serif);
        font-size: 1.2rem;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.15s;
    }

    .nl-submit:hover:not(:disabled) {
        background: #ff7e47;
        transform: translateY(-2px);
    }

    .nl-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .nl-feedback {
        margin: 0.9rem 0 0 0;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .nl-feedback.success {
        color: #4ade80;
    }

    .nl-feedback.error {
        color: #f87171;
    }

    /* --- MÓVIL (≤ 768px) --- */
    @media (max-width: 768px) {
        .newsletter-container {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 2.2rem 1.5rem 0 1.5rem;
            gap: 1.5rem;
        }

        .newsletter-content {
            align-items: center;
            padding: 0;
        }

        .newsletter-art img {
            max-width: 340px;
        }
    }
</style>