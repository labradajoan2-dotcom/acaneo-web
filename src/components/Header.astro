<header id="main-header" class="header">
    <div class="header-container">
        <button id="menu-toggle" class="mobile-toggle" aria-label="Abrir Menú">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>

        <nav class="nav-links" id="nav-menu">
            <a href="/#inicio" class="nav-item active">Inicio</a>
            <a href="https://acaneocollective.myshopify.com" class="nav-item">Tienda</a>
            <a href="/contacto" class="nav-item">Contacto</a>
            <div class="nav-indicator" id="nav-indicator"></div>
        </nav>

        <div class="logo-container">
            <a href="#inicio">
                <img src="/logo.png" alt="Acaneo Collective" class="logo-img" />
            </a>
        </div>

        <div class="header-actions">
            <div class="lang-selector-wrapper">
                <select class="lang-selector" aria-label="Idioma">
                    <option value="es">Español</option>
                    <option value="en">English</option>
                </select>
            </div>
        </div>
    </div>

    <style>
	.header {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		background-color: #29b7ef;
		backdrop-filter: blur(10px);
		z-index: 1000;
		transition: transform 0.3s ease;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}
	.header-container {
		max-width: 1800px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 4rem;
	}
	.nav-links {
		display: flex;
		gap: 2rem;
		flex: 1;
		position: relative;
		align-items: center;
	}
	.nav-item {
		color: #ffffff !important;
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		padding-bottom: 4px;
		position: relative;
		cursor: pointer;
	}
	.nav-indicator {
		position: absolute;
		bottom: -2px;
		height: 2px;
		background-color: #ffffff;
		transition: left 0.3s cubic-bezier(0.25, 1, 0.5, 1), width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
		border-radius: 2px;
	}
	.logo-container {
		flex: 1;
		display: flex;
		justify-content: center;
	}
	.logo-img {
		max-height: 60px;
		width: auto;
		display: block;
	}
	.header-actions {
		flex: 1;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 1.5rem;
	}
	.lang-selector-wrapper {
		display: flex;
		align-items: center;
		gap: 6px;
		color: #ffffff;
		font-size: 0.95rem;
	}
	.lang-selector {
		background: transparent;
		color: #ffffff;
		border: none;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		outline: none;
	}
	.lang-selector option {
		background: var(--surface-color);
		color: #ffffff;
	}
	.mobile-toggle {
		display: none;
		flex-direction: column;
		justify-content: space-between;
		width: 26px;
		height: 18px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 1001;
	}
	.mobile-toggle .bar {
		width: 100%;
		height: 2px;
		background-color: #ffffff;
		border-radius: 2px;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}
	.mobile-toggle.active .bar:nth-child(1) { transform: translateY(8px) rotate(45deg); }
	.mobile-toggle.active .bar:nth-child(2) { opacity: 0; }
	.mobile-toggle.active .bar:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

	@media(max-width: 768px) {
		.header-container {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 1rem;
		}
		.mobile-toggle { display: flex; justify-self: start; }
		.logo-container { justify-self: center; }
		.header-actions { justify-self: end; flex: unset; }
		.nav-links {
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			background-color: rgba(11, 11, 14, 0.98);
			backdrop-filter: blur(15px);
			flex-direction: column;
			align-items: center;
			padding: 2rem 0;
			gap: 1.5rem;
			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			display: none;
		}
		.nav-links.mobile-open { display: flex; }
		.nav-indicator { display: none; }
	}

    ---
interface Props {
	currentPage?: string;
}

const { currentPage = 'inicio' } = Astro.props;
---

<header id="main-header" class="header">
	<div class="header-container">
		
		<button id="menu-toggle" class="mobile-toggle" aria-label="Abrir Menú">
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>

		<!-- Navegación con clase activa dinámica -->
		<nav class="nav-links" id="nav-menu">
			<a href="/#inicio" class={`nav-item ${currentPage === 'inicio' ? 'active' : ''}`}>Inicio</a>
			<a href="/#tienda" class={`nav-item ${currentPage === 'tienda' ? 'active' : ''}`}>Tienda</a>
			<a href="/contacto" class={`nav-item ${currentPage === 'contacto' ? 'active' : ''}`}>Contacto</a>
			<div class="nav-indicator" id="nav-indicator"></div>
		</nav>

		<div class="logo-container">
			<a href="/#inicio">
				<img src="/logo.png" alt="Acaneo Collective" class="logo-img" />
			</a>
		</div>

		<div class="header-actions">
			<div class="lang-selector-wrapper">
				<select class="lang-selector" aria-label="Idioma">
					<option value="es">Español</option>
					<option value="en">English</option>
				</select>
			</div>
		</div>

	</div>
</header>
</style>
</header>