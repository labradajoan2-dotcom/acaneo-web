---
// src/components/Header.astro
---

<header class="site-header" id="siteHeader">
    <div class="header-container">
        <!-- Botón Hamburguesa (Visible solo en móvil a la izquierda) -->
        <button 
            type="button" 
            id="menuToggle" 
            class="hamburger-btn" 
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- Enlaces de navegación (A la izquierda en PC) -->
        <nav class="desktop-nav" aria-label="Navegación principal">
            <a href="/">Inicio</a>
            <a href="/archivo">Archivo</a>
            <a href="/pasaporte">Pasaporte</a>
            <a href="/#servicios">Servicios</a>
            <a href="/contacto">Contacto</a>
        </nav>

        <!-- Logo Principal (A la derecha en PC, centrado en móvil) -->
        <a href="/" class="logo" aria-label="Inicio Acaneo Collective">
            <img src="/logo.png" alt="Acaneo Collective" />
        </a>
    </div>

    <!-- Menú Desplegable (Solo móvil) -->
    <nav id="mobileMenu" class="mobile-drawer" aria-hidden="true">
        <a href="/">Inicio</a>
        <a href="/archivo">Archivo</a>
        <a href="/pasaporte">Pasaporte</a>
        <a href="/#servicios">Servicios</a>
        <a href="/contacto">Contacto</a>
    </nav>
</header>

<script>
    const header = document.getElementById('siteHeader');
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');

    function closeMobileMenu() {
        mobileMenu?.classList.remove('is-open');
        menuToggle?.classList.remove('is-active');
        menuToggle?.setAttribute('aria-expanded', 'false');
        mobileMenu?.setAttribute('aria-hidden', 'true');
    }

    menuToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = mobileMenu?.classList.toggle('is-open');
        menuToggle.classList.toggle('is-active', isOpen);
        menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
        mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMobileMenu);
    });

    document.addEventListener('click', (e) => {
        if (!mobileMenu?.classList.contains('is-open')) return;
        const target = e.target as HTMLElement;
        if (!mobileMenu.contains(target) && !menuToggle?.contains(target)) {
            closeMobileMenu();
        }
    });

    // --- OCULTAR AL BAJAR / MOSTRAR AL SUBIR ---
    let lastScrollY = window.scrollY;
    let ticking = false;

    window.addEventListener('scroll', () => {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                const currentScrollY = window.scrollY;

                // Si estamos arriba del todo, siempre visible
                if (currentScrollY <= 60) {
                    header?.classList.remove('header-hidden');
                } 
                // Scrolleando hacia abajo (con margen de 8px para evitar parpadeos)
                else if (currentScrollY > lastScrollY + 8) {
                    header?.classList.add('header-hidden');
                    closeMobileMenu(); // Cierra el menú móvil si estaba abierto
                } 
                // Scrolleando hacia arriba
                else if (currentScrollY < lastScrollY - 8) {
                    header?.classList.remove('header-hidden');
                }

                lastScrollY = currentScrollY;
                ticking = false;
            });
            ticking = true;
        }
    }, { passive: true });
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        left: 0;
        width: 100%;
        background-color: #29b7ef;
        color: #ffffff;
        z-index: 1000;
        margin: 0;
        padding: 0;
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s ease;
    }

    /* Clase aplicada al hacer scroll hacia abajo */
    .site-header.header-hidden {
        transform: translateY(-100%);
        box-shadow: none;
    }

    /* --- ESCRITORIO (PC): Menú izquierda, Logo derecha --- */
.header-container {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        max-width: 1550px;
        margin: 0 auto;
        padding: 0.9rem 2rem;
        box-sizing: border-box;
    }

    .hamburger-btn {
        display: none;
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .desktop-nav a {
        color: #ffffff;
        text-decoration: none;
        font-family: var(--font-title, sans-serif);
        font-size: 1.15rem;
        font-weight: 500;
        letter-spacing: 0.8px;
        padding: 0.35rem 0rem;
        border-radius: 8px;
        transition: background-color 0.2s, transform 0.15s;
    }

    .desktop-nav a:hover {
        background-color: #ffffff00;
        transform: translateY(-1px);
    }

    .logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        transition: transform 0.2s ease;
    }

    .logo:hover {
        transform: scale(1.03);
    }

    .logo img,
    .logo svg {
        height: 46px;
        width: auto;
        display: block;
    }

    .mobile-drawer {
        display: none;
    }

    /* --- MÓVIL (≤ 768px): Hamburguesa izquierda, Logo centrado --- */
    @media (max-width: 768px) {
        .header-container {
            display: grid;
            grid-template-columns: 42px 1fr 42px;
            padding: 0.75rem 1rem;
        }

        .desktop-nav {
            display: none;
        }

        .hamburger-btn {
            justify-self: start;
            background: transparent;
            border: none;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            width: 42px;
            height: 42px;
            padding: 8px;
            border-radius: 10px;
        }

        .hamburger-btn span {
            display: block;
            width: 100%;
            height: 3px;
            background-color: #ffffff;
            border-radius: 3px;
            transition: transform 0.25s ease, opacity 0.2s ease;
        }

        .hamburger-btn.is-active span:nth-child(1) {
            transform: translateY(8px) rotate(45deg);
        }

        .hamburger-btn.is-active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger-btn.is-active span:nth-child(3) {
            transform: translateY(-8px) rotate(-45deg);
        }

        .logo {
            justify-self: center;
        }

        .logo img,
        .logo svg {
            height: 38px;
        }

        .mobile-drawer.is-open {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.1rem;
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background-color: #0b0b0e;
            border-top: 2px solid #29b7ef;
            border-bottom: 2px solid #29b7ef;
            padding: 1.5rem 1rem;
            box-sizing: border-box;
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.75);
        }

        .mobile-drawer a {
            color: #ffffff;
            text-decoration: none;
            font-family: var(--font-title, sans-serif);
            font-size: 1.25rem;
        }

        .mobile-drawer a:hover {
            color: #eb7443;
        }
    }
</style>